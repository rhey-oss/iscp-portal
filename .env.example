# Local development database (SQLite).
# For deployment, point this at a hosted Postgres URL instead
# (e.g. Neon or Supabase) and change the Prisma datasource provider.
DATABASE_URL="file:./dev.db"

# Public college identity shown in the UI.
NEXT_PUBLIC_ISCP_NAME="International State College of the Philippines"
NEXT_PUBLIC_ISCP_SHORT_NAME="ISCP"

# Session lifetime in days (shorter is safer for student records).
SESSION_TTL_DAYS="14"

# Brute-force protection: failures allowed per email in the window,
# and the length of that window in minutes (also the lockout duration).
LOGIN_MAX_FAILURES="5"
LOGIN_WINDOW_MINUTES="15"

# Demo credentials on the sign-in page. Leave false in production.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"

# Public view-only demo: hides staff demo logins and blocks staff sign-in.
PUBLIC_DEMO_MODE="false"
NEXT_PUBLIC_PUBLIC_DEMO_MODE="false"

# Production database (Netlify/Neon): use a postgresql:// URL.
# Local development keeps SQLite above; the Netlify build uses
# prisma/schema.postgres.prisma automatically.
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Cloudflare R2 object storage for uploads (leave blank for local disk in dev).
# Create a bucket and an S3 API token with Object Read & Write permission.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
